<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF2C2C34" android:endColor="#FF0A0A0C" android:angle="315" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:gravity="center" android:width="36dp" android:height="36dp">
        <shape android:shape="oval">
            <solid android:color="#FFF2F2F7" />
        </shape>
    </item>
</layer-list>
